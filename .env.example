# ---------------------------------------------------------------------------
# Browser configuration (bundled into the client — never put secrets here)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SITE_URL=http://localhost:5173

# Optional marketing/footer destinations. Links with no URL are not rendered.
VITE_SUPPORT_EMAIL=
VITE_ABOUT_URL=
VITE_CAREERS_URL=
VITE_BLOG_URL=
VITE_HELP_URL=
VITE_GUIDELINES_URL=
VITE_TERMS_URL=
VITE_PRIVACY_URL=
VITE_COOKIES_URL=
VITE_AI_DISCLOSURE_URL=
VITE_IOS_APP_URL=
VITE_ANDROID_APP_URL=

# Optional observability
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=

# ---------------------------------------------------------------------------
# Edge function secrets — set with `supabase secrets set`, never in this file
# on a deployed project.
#
#   SITE_URL=https://your-app.example
#   # Only needed when SUPABASE_URL is an internal address (self-hosting or
#   # the local CLI stack), so signed download URLs are reachable by browsers:
#   PUBLIC_SUPABASE_URL=https://your-project.supabase.co
#   ALLOWED_ORIGINS=https://your-app.example
#   GENERATION_PROVIDER=mock            # or: replicate
#   REPLICATE_API_TOKEN=
#   REPLICATE_MODEL_VERSION=
#   STRIPE_SECRET_KEY=sk_live_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
#   STRIPE_AUTOMATIC_TAX=false      # true only if Stripe Tax is configured
#   STRIPE_PRICE_PRO_MONTHLY=price_...
#   STRIPE_PRICE_PRO_YEARLY=price_...
#   STRIPE_PRICE_PREMIER_MONTHLY=price_...
#   STRIPE_PRICE_PREMIER_YEARLY=price_...
# ---------------------------------------------------------------------------

# Playwright end-to-end tests (see e2e/README)
E2E_BASE_URL=http://localhost:5173
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
